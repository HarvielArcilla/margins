{
  "name": "margins",
  "productName": "Margins",
  "version": "1.0.0",
  "description": "A deeply customizable ePub reader for macOS and Windows — fonts, spacing, color schemes, highlights, page-turn styles, presets and reading stats.",
  "main": "src/main/main.js",
  "author": {
    "name": "Harviel Arcilla",
    "url": "https://harvielarcilla.github.io"
  },
  "license": "MIT",
  "homepage": "https://github.com/HarvielArcilla/margins",
  "repository": {
    "type": "git",
    "url": "https://github.com/HarvielArcilla/margins.git"
  },
  "keywords": [
    "epub",
    "ebook",
    "reader",
    "electron"
  ],
  "scripts": {
    "fonts": "node scripts/build-fonts.mjs",
    "postinstall": "node scripts/build-fonts.mjs",
    "start": "electron .",
    "sample-book": "python3 scripts/make-sample-epub.py samples/sample.epub",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist": "electron-builder"
  },
  "dependencies": {
    "epubjs": "^0.3.93"
  },
  "devDependencies": {
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/andika": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/bitter": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/crimson-pro": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/fira-sans": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/gentium-book-plus": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lexend": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/libre-caslon-text": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/noto-serif": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/pt-serif": "^5.3.0",
    "@fontsource/roboto-slab": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@fontsource/source-serif-4": "^5.3.1",
    "@fontsource/spectral": "^5.3.0",
    "@fontsource/vollkorn": "^5.3.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.harvielarcilla.margins",
    "productName": "Margins",
    "copyright": "Copyright © 2026 Harviel Arcilla",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "!src/**/*.map"
    ],
    "fileAssociations": [
      {
        "ext": "epub",
        "name": "ePub book",
        "role": "Viewer",
        "mimeType": "application/epub+zip"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.books",
      "icon": "build/icon.icns",
      "darkModeSupport": true
    },
    "dmg": {
      "title": "Margins"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "portable": {
      "artifactName": "Margins-${version}-portable.exe"
    },
    "publish": null,
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    }
  }
}
